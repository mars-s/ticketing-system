generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum TicketStatus {
  open
  pending
  escalated
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketType {
  bug
  suggestion
  improvement
  feature
  question
  other
}

enum MaintenanceStatus {
  scheduled
  in_progress
  resolved
}

enum MaintenanceSource {
  manual
  uptime_kuma
}

enum NotificationType {
  reply
  status_changed
  sla_breach
}

enum DiscordDmKind {
  pending_notice
  pending_escalation
  reply_reminder
  ticket_created
  reply
  status_updated
  closed
  resolved
  sla_breach
  assignee_updated
  assignee_idle_reminder
}

enum DiscordChannelMessageKind {
  ticket_created
  unassigned_backlog
}

/// BetterAuth-managed user table. id/email/emailVerified/name/image/createdAt/updatedAt
/// are BetterAuth core fields; role/discordId are additionalFields configured in auth.ts.
/// The Authentik `sub` lives on Account.accountId (providerId="authentik"), not here.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  image         String?
  role          UserRole  @default(user)
  discordId     String?   @unique
  /// Raw Authentik group names from the last sync (see syncAuthentikUsers). Used to
  /// (re)compute TicketGroup membership -- not itself used for authorization directly.
  authentikGroups String[] @default([])
  /// True for a Discord-only placeholder account created before the user has
  /// signed in via Authentik. Cleared (and the row deleted) once claimed --
  /// see DiscordClaim.
  isDiscordPlaceholder Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  ticketsCreated  Ticket[]        @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]        @relation("TicketAssignees")
  ticketsWatching Ticket[]        @relation("TicketWatchers")
  messages        TicketMessage[]
  discordClaim    DiscordClaim?
  auditLogs       AuditLog[]
  uploadedAttachments TicketAttachment[]
  notifications   Notification[]
  ticketShareLinksCreated TicketShareLink[]
  ticketHistoryEntries    TicketHistory[]
  ticketGroups            TicketGroup[]   @relation("TicketGroupMembers")

  @@map("users")
}

/// BetterAuth core table.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

/// BetterAuth core table. accountId = upstream provider's subject (Authentik `sub`).
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// BetterAuth core table (email verification / oauth state, etc).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Ticket {
  id                String       @id @default(cuid())
  /// Human-readable ref shown to users/admins/Discord, e.g. "INC-2026-000123".
  /// Distinct from `id` (internal cuid PK). Generated from TicketIncidentCounter,
  /// see nextIncidentNumber() in server/tickets.ts.
  incidentNumber    String       @unique
  title             String
  description       String
  status            TicketStatus @default(open)
  priority          TicketPriority @default(normal)
  type              TicketType   @default(other)
  createdById       String
  createdBy         User         @relation("TicketCreatedBy", fields: [createdById], references: [id])
  /// Which TicketGroup this ticket was sent to. Null = "unsure" -- admin-only, same as
  /// the pre-groups behavior. Set at creation, reassignable by admins afterward.
  groupId           String?
  group             TicketGroup? @relation(fields: [groupId], references: [id])
  discordChannelId  String?
  /// Client-generated key from the Discord bot's /ticket interaction, unique per submission.
  /// Lets createTicketFromDiscord detect a retried request and return the existing ticket
  /// instead of creating a duplicate.
  discordIdempotencyKey String? @unique
  slaDueAt          DateTime?
  resolvedAt        DateTime?
  /// Set when status transitions into `pending`; cleared when it leaves. Drives the
  /// 24-hour escalation reminder DM and dedupes the initial "awaiting your response" DM.
  pendingSince           DateTime?
  pendingEscalationSentAt DateTime?
  /// Set once the SLA-breach alert DM/notification has been sent, so the hourly sweep
  /// doesn't re-notify every run. Cleared whenever slaDueAt is pushed out or the ticket resolves.
  slaBreachNotifiedAt DateTime?
  /// Set whenever status transitions into (or between) open/in_progress/escalated; cleared
  /// on leaving that set. Drives the 24h "still sitting" reminder DM to assignees -- distinct
  /// from pendingSince, which is pending-only and targets the creator, not assignees.
  activeSince           DateTime?
  activeReminderSentAt  DateTime?
  /// Aggregates title/description + ticket_messages.body + ticket_attachments.ocrText,
  /// maintained by Postgres triggers (see migration) -- not written from application code.
  /// Prisma can't model tsvector directly, so this field is unreadable/unwritable via the
  /// client; all access to it goes through prisma.$queryRaw in listTicketsForAdminQueue.
  searchVector      Unsupported("tsvector")?
  /// Answers to the routed group's custom fields at creation time, keyed by field id.
  /// Only fields that were actually visible (per the group's visibility rules) at submit
  /// time are stored -- see createTicket() in server/tickets.ts. Null if the group has no
  /// custom fields, the ticket wasn't routed to a group, or the group uses the default form.
  customFieldValues Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  messages      TicketMessage[]
  accessTokens  TicketAccessToken[]
  shareLinks    TicketShareLink[]
  attachments   TicketAttachment[]
  tags          Tag[]               @relation("TicketTags")
  watchers      User[]              @relation("TicketWatchers")
  assignees     User[]              @relation("TicketAssignees")
  notifications Notification[]
  discordDms    DiscordDm[]
  history       TicketHistory[]
  exportJobs    TicketExportJob[]

  @@index([status])
  @@index([createdById])
  @@index([slaDueAt])
  @@index([groupId])
  @@map("tickets")
}

/// Admin-defined routing group (e.g. "Networking", "Facilities"). Linked to one or more
/// Authentik groups via the settings picker -- membership is recomputed from
/// User.authentikGroups on every syncAuthentikUsers run, not stored as a static list.
model TicketGroup {
  id                          String   @id @default(cuid())
  name                        String   @unique
  /// Authentik group names whose members belong to this TicketGroup. Requires >= 1.
  authentikGroupNames         String[] @default([])
  /// Posted to when a ticket is routed to this group. Null = feature off for this group.
  announcementChannelId       String?
  /// Daily unassigned-backlog count for this group. Multiple groups may share the same
  /// channel id -- see queueUnassignedBacklogAlert, which aggregates by channel, not group.
  unassignedBacklogChannelId  String?
  /// Null = default create-ticket form (all standard fields shown, no custom fields).
  /// Validated shape: GroupFormConfig (packages/shared/src/fieldConfig.ts). Editable by
  /// group members (form config only) or admins (this plus everything else on the group)
  /// -- see isTicketGroupMember/updateTicketGroupFormConfig in server/ticketGroups.ts.
  formConfig                  Json?
  /// Null = ticket export off for this group. Validated shape: GroupExportConfig
  /// (packages/shared/src/exportConfig.ts). Same edit gate as formConfig -- group
  /// members or admins, see isTicketGroupMember/updateTicketGroupExportConfig.
  exportConfig                 Json?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  members User[]   @relation("TicketGroupMembers")
  tickets Ticket[]
  exportJobs TicketExportJob[]

  @@map("ticket_groups")
}

enum TicketExportTarget {
  notion
  google_sheets
}

/// Outbox row per (ticket, target) mutation a group wants mirrored to Notion/Sheets. The
/// web app enqueues rows inline with the ticket create/update transaction; an external cron
/// polls POST /api/internal/ticket-exports/pending, which delivers directly to the Notion/
/// Sheets APIs (no bot/gateway needed for either, unlike Discord) -- mirrors the enqueue-
/// then-deliver shape of DiscordDm/DiscordChannelMessage.
model TicketExportJob {
  id       String             @id @default(cuid())
  ticketId String
  ticket   Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  groupId  String
  group    TicketGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  target   TicketExportTarget
  /// Snapshot of the row to write, computed at enqueue time so delivery doesn't need to
  /// re-read a possibly-since-changed ticket. Shape: TicketExportSnapshot.
  payload   Json
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sentAt])
  @@index([target, createdAt])
  @@index([groupId, target, createdAt])
  @@map("ticket_export_jobs")
}

/// Backs Ticket.incidentNumber generation: one row per calendar year, incremented
/// atomically (INSERT ... ON CONFLICT DO UPDATE) inside the same transaction as the
/// ticket create, so numbers are gapless-per-year and collision-free under concurrency.
model TicketIncidentCounter {
  year      Int @id
  lastValue Int @default(0)

  @@map("ticket_incident_counters")
}

/// In-app notification tray entry. One row per (user, event) -- e.g. every watcher on a
/// ticket gets their own row when a reply lands, so read state is per-user.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([ticketId])
  @@map("notifications")
}

/// Outbound Discord DM queue. The web app enqueues rows; apps/bot polls
/// /api/internal/discord-dms/pending and sends them via the external Discord bot HTTP API.
model DiscordDm {
  id           String        @id @default(cuid())
  discordUserId String
  ticketId     String
  ticket       Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind         DiscordDmKind
  message      String
  sentAt       DateTime?
  createdAt    DateTime      @default(now())

  @@index([sentAt])
  @@map("discord_dms")
}

/// Outbound Discord channel-message queue, mirrors DiscordDm. apps/bot polls this
/// alongside the DM queue and posts via discordbot's POST /api/v1/messages/.
model DiscordChannelMessage {
  id        String                     @id @default(cuid())
  channelId String
  kind      DiscordChannelMessageKind
  message   String
  sentAt    DateTime?
  createdAt DateTime                   @default(now())

  @@index([sentAt])
  @@index([kind, createdAt])
  @@map("discord_channel_messages")
}

/// Singleton admin-configurable Discord settings row (id is always "singleton").
/// Edited via /admin/settings, gated the same as the rest of /admin (role === 'admin').
model DiscordSettings {
  id                        String   @id @default("singleton")
  /// Channel a "new ticket created" message is posted to. Null = feature off.
  newTicketChannelId        String?
  /// Channel the daily unassigned-ticket-backlog alert is posted to. Null = feature off.
  unassignedAlertChannelId  String?
  updatedById               String?
  updatedAt                 DateTime @updatedAt

  @@map("discord_settings")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  tickets Ticket[] @relation("TicketTags")

  @@map("tags")
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String   @unique
  /// OCR-extracted text (image attachments only). Null = not yet attempted or not
  /// an OCR-eligible mime type; see ocrProcessedAt to distinguish the two.
  ocrText       String?
  /// Stamped after one OCR attempt, success or failure, so the sweep never retries
  /// forever. Non-null with ocrText null means OCR ran and found/extracted nothing.
  ocrProcessedAt DateTime?
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([ocrProcessedAt])
  @@map("ticket_attachments")
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  body           String
  isInternalNote Boolean  @default(false)
  isSystemMessage Boolean @default(false)
  createdAt      DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketAccessToken {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_access_tokens")
}

/// A "Share ticket" invite link. Unlike TicketAccessToken (unauthenticated view-only, minted
/// for pre-link Discord users), redeeming this always requires signing in, and doing so adds
/// the signed-in user as a ticket watcher (CC). Not single-use -- anyone holding the link can
/// redeem it until it expires, so multiple people can be CC'd from the same link.
model TicketShareLink {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@map("ticket_share_links")
}

/// Tracks a pending Discord-to-Authentik claim for a placeholder user created
/// from a bot-side ticket. One row per placeholder; regenerated/refreshed
/// each time that Discord user opens another ticket before claiming.
model DiscordClaim {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  placeholderUserId String   @unique
  placeholderUser   User     @relation(fields: [placeholderUserId], references: [id], onDelete: Cascade)
  ticketId          String
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@map("discord_claims")
}

model MaintenanceEvent {
  id            String            @id @default(cuid())
  title         String
  body          String
  status        MaintenanceStatus @default(scheduled)
  startAt       DateTime
  endAt         DateTime?
  source        MaintenanceSource @default(manual)
  kumaMonitorId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([kumaMonitorId])
  @@map("maintenance_events")
}

enum TicketHistoryField {
  status
  priority
  sla
  tag
  watcher
  attachment
  group
}

enum TicketHistoryAction {
  changed
  added
  removed
}

/// User-facing ticket timeline, distinct from AuditLog (which is generic/internal and never
/// rendered). One row per discrete change -- a single updateTicket() call can emit several
/// rows (e.g. a tag added and priority changed in the same PATCH each get their own row).
model TicketHistory {
  id        String              @id @default(cuid())
  ticketId  String
  ticket    Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?               @relation(fields: [actorId], references: [id])
  field     TicketHistoryField
  action    TicketHistoryAction
  fromValue String?
  toValue   String?
  createdAt DateTime            @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_history")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@map("audit_log")
}
